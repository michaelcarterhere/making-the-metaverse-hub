---
import { Image } from "astro:assets";
import Headshot from "@/images/authors/michael_headshot.jpeg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Link from "@/components/fundations/elements/Link.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-12">
      <div
        class="p-10 rounded-4xl lg:rounded-[4rem] bg-base-900 lg:px-20 lg:py-24"
      >
        <div class="grid grid-cols-1 lg:grid-cols-2 items-end gap-12">
          <div>
            <span class="text-base-400 text-xs font-mono font-light">About</span>
            <Text
              tag="h1"
              variant="textXL"
              class="font-light font-mono text-white mt-8 text-balance"
            >
              Making the Metaverse
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="text-base-200 pl-8 mt-4 font-light text-balance"
            >
              Making the Metaverse is a podcast hosted by
              <a href="https://michaelcarter.ai" class="text-white hover:underline">Michael Carter</a>. The
              show has about 88 episodes over four years.
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="text-base-200 pl-8 mt-4 font-light text-balance"
            >
              Michael has spent several years advising technology startups, helping
              founders with product development and go-to-market strategy. He is a
              professor and program coordinator in the School of Applied Science and
              Computing at St. Lawrence College, where he also teaches in the
              Bachelor of Commerce in Social Innovation program.
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="text-base-200 pl-8 mt-4 font-light text-balance"
            >
              His recent ventures include an image generator for content creators
              and FAQsy, an EdTech firm. He also founded ontheblockchain.ca, hosts
              the podcast Making the Metaverse, and co-edits When Sparks Speak, an
              online publication celebrating women leading in tech.
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="text-base-200 pl-8 mt-4 font-light text-balance"
            >
              He studied business at Toronto Metropolitan University before becoming
              a researcher focused on technology adoption at Queen’s University and
              the University of Toronto. He also holds an Executive MBA.
            </Text>
            <div class="flex flex-wrap pl-8 mt-8 gap-2">
              <Link
                href="https://open.spotify.com/show/5hFpZuDCNhy7mertvzzxlb"
                size="sm"
                variant="accent"
              >
                Listen on Spotify
              </Link>
              <Link
                href="https://podcasts.apple.com/us/podcast/making-the-metaverse/id1609547540"
                size="sm"
                variant="muted"
              >
                Listen on Apple Podcasts
              </Link>
              <Link href="/podcast/home" size="sm" variant="muted">
                Episodes on this site
              </Link>
            </div>
          </div>
          <Image
            width={400}
            height={400}
            src={Headshot}
            alt="Michael Carter"
            class="object-cover object-center ml-auto size-24 lg:size-48 rounded-4xl"
          />
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
