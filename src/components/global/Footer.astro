---
import Logo from "@/components/assets/Logo.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

const sections = [
  {
    title: "Making the Metaverse",
    links: [
      { name: "Home", url: "/" },
      { name: "Blog", url: "/blog" },
      { name: "Podcast", url: "/podcast/home" },
      { name: "About", url: "/about" },
    ],
  },
  {
    title: "Listen",
    links: [
      { name: "Spotify", url: "https://open.spotify.com/show/5hFpZuDCNhy7mertvzzxlb" },
      { name: "Apple Podcasts", url: "https://podcasts.apple.com/us/podcast/making-the-metaverse/id1609547540" },
    ],
  },
  {
    title: "Connect",
    links: [
      { name: "LinkedIn", url: "https://www.linkedin.com/in/mcarter2013/" },
      { name: "Michael Carter", url: "https://michaelcarter.ai" },
      { name: "When Sparks Speak magazine", url: "https://whensparksspeak.com" },
    ],
  },
];

if (tags.length) {
  sections.splice(1, 0, {
    title: "Categories",
    links: tags.map((tag) => ({
      name: tag.replace(/-/g, " "),
      url: `/blog/tags/${tag}`,
    })),
  });
}
---

<footer>
  <Wrapper variant="standard" class="py-2">
    <div class="grid grid-cols-1 lg:grid-cols-6 lg:row-span-2 gap-2">
      {
        sections.map((section) => (
          <div class="p-8 bg-base-100 rounded-4xl">
            <Text tag="h3" variant="textSM" class="font-mono  text-base-900">
              {section.title}
            </Text>
            <ul role="list" class="pl-8 ">
              {section.links.map((link) => (
                <li>
                  <Text
                    tag="a"
                    variant="textXS"
                    href={link.url}
                    class="text-xs text-base-600 hover:text-base-900 capitalize"
                  >
                    {link.name}
                  </Text>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div
        class="p-8 bg-base-900 rounded-4xl flex flex-col items-center justify-center"
      >
        <Text tag="p" variant="textXL" class="font-mono text-white">
          <Logo />
        </Text>
      </div>
      <div
        class="p-8 bg-orange-500 rounded-4xl lg:col-span-2 flex flex-col items-center justify-center"
      >
        <Text tag="p" variant="textSM" class="font-mono text-base-900">
          © <span id="year"></span> Michael Carter
        </Text>
      </div>
    </div>
  </Wrapper>
</footer>
<script type="module">
  document.getElementById("year").textContent = new Date().getFullYear();
</script>
