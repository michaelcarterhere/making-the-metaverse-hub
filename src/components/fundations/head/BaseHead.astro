---
import Seo from "@/components/fundations/head/Seo.astro";
import Meta from "@/components/fundations/head/Meta.astro";
import Fonts from "@/components/fundations/head/Fonts.astro";
import Favicons from "@/components/fundations/head/Favicons.astro";
// Scripts
import KeenSlider from "@/components/fundations/scripts/KeenSlider.astro";
import TickerHideScript from "@/components/fundations/scripts/TickerHideScript.astro";
import NavigationScript from "@/components/fundations/scripts/NavigationScript.astro";

// Cloudflare Web Analytics. Omitted when PUBLIC_CF_BEACON_TOKEN is unset.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? "";
---

<Seo />
<Meta />
<Fonts />
<Favicons />
<!---- Scripts -->
<KeenSlider />

<TickerHideScript />
<NavigationScript />

{cfBeaconToken && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
  ></script>
)}
